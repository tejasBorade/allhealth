# Copy to .env.local for local dev (never commit the real file — .gitignore already blocks .env*)

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, bypasses RLS. Used by cron/webhook routes only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (transactional email for reminders)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=alerts@yourdomain.com

# Web Push (VAPID) — generate once with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# Shared secret the Vercel Cron request must present, so /api/cron/* can't be
# triggered by anyone who guesses the URL. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# IANA timezone used for all reminder time math (parsing frequency codes like
# BD/TDS/QID, computing appointment 24h/1h windows). There's no per-patient
# timezone column yet, so this is a fixed clinic-wide assumption, not a
# per-user setting.
REMINDER_TIMEZONE=Asia/Kolkata

# Base URL used to build links in outbound emails (e.g. the visit report
# link). On Vercel this can be left unset — VERCEL_URL is auto-populated.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Groq API key (free tier, no credit card required) — powers the AI Patient
# Risk & Adherence Digest (doctor dashboard) and the patient chat assistant.
# Get one at https://console.groq.com/keys. Open-weight models only (no
# Anthropic/OpenAI usage). Optional for the digest — if unset, it still
# computes and shows deterministic adherence/vitals numbers, just without
# the AI-authored one-line summary/suggested action.
GROQ_API_KEY=
RISK_DIGEST_MODEL=openai/gpt-oss-20b

# Model used by the patient chat assistant (search doctors, book/cancel
# appointments, list & download prescriptions/reports). Reuses GROQ_API_KEY
# above — if that's unset, the chat widget shows a disabled state instead
# of erroring.
CHAT_MODEL=openai/gpt-oss-120b
