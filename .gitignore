# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local Claude Code scratch/reference material — not part of the app, and
# not meant to be published to this public repo (e.g. design mockups or
# reference docs dropped in for a session, not vetted for redistribution)
.claude/*
!.claude/settings.json

# typescript
*.tsbuildinfo
next-env.d.ts
